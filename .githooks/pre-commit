#!/usr/bin/env bash
# Installed via `npm run prepare` (git config core.hooksPath .githooks).
# Runs three gates before a commit that touches articles, so obvious typos,
# mis-styled callouts, and dead external links are caught locally before they
# reach the deploy pipeline:
#
#   1. callout gate              (scripts/gates/check-callouts.js)
#      staged articles may only use the alert types the theme styles
#      ([!NOTE]/[!TIP]/[!WARNING]), with well-formed markers, no redundant
#      bold mini-titles, and no bold pseudo-callout paragraphs.
#   2. content spelling gate     (scripts/gates/check-spelling.js)
#   3. external-link gate        (scripts/gates/check-external-links.js)
#      verifies every external link in the staged article(s); domains not yet
#      registered in scripts/gates/external-link-domains.js block the commit
#      with instructions.
#
# Emergency bypasses (or git commit --no-verify for everything):
#   SKIP_CALLOUT_CHECK=1 git commit ...  skip the callout gate
#   SKIP_SPELLING=1 git commit ...       skip the spelling gate
#   SKIP_LINK_CHECK=1 git commit ...     skip the external-link gate

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"

# Only run when the commit stages Markdown under src/content (ACMR: renamed
# articles count too — a slug rename is exactly when links get touched).
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '^src/content/.*\.md$'; then
  exit 0
fi

# The callout gate is dependency-free (plain node), so it runs even on a
# machine that has not run `npm ci` yet.
if [[ "${SKIP_CALLOUT_CHECK:-}" == "1" ]]; then
  echo "pre-commit: SKIP_CALLOUT_CHECK=1 set; skipping callout gate."
else
  echo "pre-commit: running callout gate on staged articles..."
  ( cd "$repo_root" && node scripts/gates/check-callouts.js --staged )
fi

if [[ ! -d "$repo_root/node_modules/nspell" ]]; then
  echo "pre-commit: dependencies not installed (run 'npm ci'); skipping spelling and link gates." >&2
  exit 0
fi

if [[ "${SKIP_SPELLING:-}" == "1" ]]; then
  echo "pre-commit: SKIP_SPELLING=1 set; skipping spelling gate."
else
  echo "pre-commit: running content spelling gate..."
  ( cd "$repo_root" && npm run --silent check:spelling )
fi

if [[ "${SKIP_LINK_CHECK:-}" == "1" ]]; then
  echo "pre-commit: SKIP_LINK_CHECK=1 set; skipping external-link gate."
else
  echo "pre-commit: running external-link gate on staged articles..."
  ( cd "$repo_root" && npm run --silent check:external-links -- --staged )
fi

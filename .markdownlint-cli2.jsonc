{
  // src/layouts/**/*.md are Hugo Go-template output-format templates (e.g.
  // single.markdown.md, home.markdown.md) that generate Markdown + YAML
  // front matter at build time — they are not authored prose, and their
  // template syntax (`{{- ... -}}`) before the real `---` front matter
  // delimiter defeats markdownlint's front-matter detection, so the whole
  // file gets misread as broken Markdown (frontmatter dashes as setext
  // headings, template lines as list items, etc). Same rationale as the
  // MD034 exception below: markdownlint has no Hugo-template awareness.
  "ignores": ["src/layouts/**/*.md"],
  "config": {
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD028": false,
    // MD034 (no-bare-urls) misreads URLs inside Hugo shortcode attributes
    // (e.g. {{< img-caption link="https://…" >}}) as prose bare URLs; its
    // --fix wraps them in <…>, which Hugo renders literally into the href
    // and breaks the internal-link SEO gate. See docs/publishing/deploy-gate-matrix.md.
    "MD034": false,
    "MD041": false
  }
}
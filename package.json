    "check:html-conformance": "node scripts/phase-8/check-html-conformance.js",
    "check:https-security": "node scripts/phase-8/check-https-security.js",
    "check:production-validation-build": "node scripts/phase-8/check-production-validation-build.js",
    "check:preview-launch-readiness": "node scripts/phase-8/check-preview-launch-readiness.js",
    "check:search-console-auth": "node scripts/phase-9/check-search-console-auth.js",
    "check:local-video-shortcodes": "node scripts/migration/check-local-video-shortcodes.js",

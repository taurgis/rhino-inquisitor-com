{{ $page := . }}
{{ $lastmod := $page.Lastmod }}
{{ if and $lastmod.IsZero (eq $page.Kind "term") }}
  {{ with first 1 ((where site.RegularPages "Type" "posts").ByLastmod.Reverse) }}
    {{ $lastmod = (index . 0).Lastmod }}
  {{ end }}
{{ end }}
<url>
  <loc>{{ $page.Permalink }}</loc>
  {{ if not $lastmod.IsZero }}
    <lastmod>{{ $lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
  {{ end }}
</url>

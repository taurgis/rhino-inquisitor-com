{{ $page := .page }}
{{ $paginateSize := .paginateSize | default 10 }}
{{ $totalPages := len $page.RegularPages }}
{{ if eq $page.Section "pages" }}
  {{ $excludedPageArchivePaths := slice "/archive/" "/offline/" "/scaffold-readiness/" }}
  {{ $filtered := 0 }}
  {{ range $page.RegularPages }}
    {{ if and (not (in $excludedPageArchivePaths .RelPermalink)) (ne .Params.archiveExclude true) (ne .Params.pageArchiveExclude true) (ne .Params.scaffoldFixture true) }}
      {{ $filtered = add $filtered 1 }}
    {{ end }}
  {{ end }}
  {{ $totalPages = $filtered }}
{{ end }}
{{ $numPaginatedPages := 1 }}
{{ if gt $totalPages $paginateSize }}
  {{ $numPaginatedPages = int (math.Ceil (div (float $totalPages) (float $paginateSize))) }}
{{ end }}
{{ if gt $numPaginatedPages 1 }}
  {{ range seq 2 $numPaginatedPages }}
    {{ $pageURL := printf "%spage/%d/" $page.RelPermalink . }}
    <url>
      <loc>{{ $pageURL | absLangURL }}</loc>
      {{ if not $page.Lastmod.IsZero }}
        <lastmod>{{ $page.Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
      {{ end }}
    </url>
  {{ end }}
{{ end }}

{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {{ range .Pages }}
    {{ $seo := .Params.seo | default dict }}
    {{ if and (not .Sitemap.Disable) (not (index $seo "noindex")) }}
      {{ $lastmod := .Lastmod }}
      {{ if and $lastmod.IsZero (eq .Kind "term") }}
        {{ with first 1 ((where site.RegularPages "Type" "posts").ByLastmod.Reverse) }}
          {{ $lastmod = (index . 0).Lastmod }}
        {{ end }}
      {{ end }}
      <url>
        <loc>{{ .Permalink }}</loc>
        {{ if not $lastmod.IsZero }}
          <lastmod>{{ $lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
        {{ end }}
        {{ with .Sitemap.ChangeFreq }}
          <changefreq>{{ . }}</changefreq>
        {{ end }}
        {{ if ge .Sitemap.Priority 0.0 }}
          <priority>{{ .Sitemap.Priority }}</priority>
        {{ end }}
      </url>
    {{ end }}
  {{ end }}

  {{ $paginateSize := 10 }}
  {{ $excludedPageArchivePaths := slice "/archive/" "/offline/" "/scaffold-readiness/" }}
  {{ range (slice "/pages" "/posts") }}
    {{ with site.GetPage . }}
      {{ $sectionPage := . }}
      {{ $totalPages := len $sectionPage.RegularPages }}
      {{ if eq $sectionPage.Section "pages" }}
        {{ $filtered := 0 }}
        {{ range $sectionPage.RegularPages }}
          {{ if and (not (in $excludedPageArchivePaths .RelPermalink)) (ne .Params.archiveExclude true) (ne .Params.pageArchiveExclude true) (ne .Params.scaffoldFixture true) }}
            {{ $filtered = add $filtered 1 }}
          {{ end }}
        {{ end }}
        {{ $totalPages = $filtered }}
      {{ end }}
      {{ $numPaginatedPages := 1 }}
      {{ if gt $totalPages $paginateSize }}
        {{ $numPaginatedPages = int (math.Ceil (div (float $totalPages) (float $paginateSize))) }}
      {{ end }}
      {{ if gt $numPaginatedPages 1 }}
        {{ range seq 2 $numPaginatedPages }}
          {{ $pageUrl := printf "%spage/%d/" $sectionPage.RelPermalink . }}
            <url>
              <loc>{{ $pageUrl | absLangURL }}</loc>
              {{ if not $sectionPage.Lastmod.IsZero }}
                <lastmod>{{ $sectionPage.Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
              {{ end }}
              {{ with $sectionPage.Sitemap.ChangeFreq }}
                <changefreq>{{ . }}</changefreq>
              {{ end }}
              {{ if ge $sectionPage.Sitemap.Priority 0.0 }}
                <priority>{{ $sectionPage.Sitemap.Priority }}</priority>
              {{ end }}
            </url>
        {{ end }}
      {{ end }}
    {{ end }}
  {{ end }}
</urlset>
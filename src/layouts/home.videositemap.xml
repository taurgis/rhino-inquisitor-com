{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:video="http://www.google.com/schemas/sitemap-video/1.1">
{{ range site.RegularPages.ByLastmod.Reverse }}
  {{ $video := .Params.video | default dict }}
  {{ $videoID := index $video "id" }}
  {{ if and $videoID (partial "sitemap/is-indexable.html" .) }}
    {{ $seo := partial "seo/resolve.html" . }}
    {{ $title := index $video "title" | default .Title }}
    {{ $description := index $video "description" | default $seo.description }}
    {{ $thumbnail := index $video "thumbnailUrl" | default $seo.image }}
    {{ if and $title $description $thumbnail }}
      {{ $uploadDate := .Date.Format "2006-01-02T15:04:05Z07:00" }}
      {{ with index $video "uploadDate" }}{{ $uploadDate = . }}{{ end }}
      <url>
        <loc>{{ .Permalink }}</loc>
        {{ if not .Lastmod.IsZero }}
          <lastmod>{{ .Lastmod.Format "2006-01-02T15:04:05-07:00" }}</lastmod>
        {{ end }}
        <video:video>
          <video:thumbnail_loc>{{ $thumbnail }}</video:thumbnail_loc>
          <video:title>{{ $title }}</video:title>
          <video:description>{{ $description }}</video:description>
          <video:player_loc allow_embed="yes">https://www.youtube-nocookie.com/embed/{{ $videoID }}?rel=0</video:player_loc>
          <video:publication_date>{{ $uploadDate }}</video:publication_date>
        </video:video>
      </url>
    {{ end }}
  {{ end }}
{{ end }}
</urlset>
